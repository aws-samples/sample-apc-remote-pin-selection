# Backend configuration for the remote PIN selection demo.
#
# The README setup steps create the AWS resources and write backend/.env from
# `terraform output`. Use this file as a reference, or to fill in resources you
# created yourself. Never commit the populated backend/.env.

# Region that contains every resource below.
AWS_REGION=

# HTTP listen address. Loopback by default, so only this machine can reach the
# backend. Docker Compose sets :8080 inside the container and publishes the
# port on 127.0.0.1 only.
BACKEND_ADDR=127.0.0.1:8080

# Comma-separated browser origins allowed to call the API (CORS). Match the URL
# you open the web app at.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# ---------------------------------------------------------------------------
# Issuer side
# ---------------------------------------------------------------------------

# AWS Private CA (SHORT_LIVED_CERTIFICATE mode, EC_prime256v1) that issues the
# app's client certificate. Backend needs acm-pca:IssueCertificate and
# acm-pca:GetCertificate on this CA.
PRIVATE_CA_ARN=

# The Private CA certificate imported into Payment Cryptography as a root
# certificate public key. Passed to TranslatePinData as
# CertificateAuthorityPublicKeyIdentifier.
APC_CA_PUBLIC_KEY_ARN=

# ECC_NIST_P256 key-agreement key (TR31_K3_ASYMMETRIC_KEY_FOR_KEY_AGREEMENT).
# The app performs ECDH against this key's public certificate.
APC_KEY_AGREEMENT_KEY_ARN=

# TDES_2KEY PIN encryption key (TR31_P0_PIN_ENCRYPTION_KEY). TranslatePinData
# re-encrypts the PIN block under this key for the processor.
APC_PEK_ARN=

# ---------------------------------------------------------------------------
# Processor side (demo stand-in)
# ---------------------------------------------------------------------------

# TDES_2KEY Visa PIN verification key (TR31_V2_VISA_PIN_VERIFICATION_KEY) and
# its index (PVKI). Used by GeneratePinData and VerifyPinData.
APC_PVK_ARN=
APC_PVK_INDEX=1

# DynamoDB table (partition key "pan", String) that stores PVV verifier
# records. Synthetic PANs only.
PIN_VERIFIER_TABLE_NAME=

# Optional DynamoDB Local endpoint, for docker-compose.local.yaml only.
# DYNAMODB_ENDPOINT=http://localhost:8000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# debug prints numbered flow steps. Steps never include PANs, PIN blocks, or
# verifier values.
LOG_LEVEL=info

# DEMO ONLY. With LOG_LEVEL=debug, also print the synthetic PAN, the encrypted
# PIN blocks, the key check value, and the PVV. Never enable with real
# cardholder data.
DEMO_LOG_SENSITIVE_VALUES=false
