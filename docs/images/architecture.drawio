                    <mxGeometry width="300" height="560" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="&lt;b&gt;1. Mobile or web application&lt;/b&gt;&#xa;Captures the PIN, generates an ephemeral P-256 key pair and CSR, derives a temporary key via ECDH, and builds the encrypted PIN block." style="text;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;align=left;verticalAlign=top;whiteSpace=wrap;" parent="6" vertex="1">
                    <mxGeometry x="18" y="26" width="266" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="&lt;b&gt;2. Issuer backend&lt;/b&gt;&#xa;Authenticates and authorizes the operation, coordinates certificate issuance, and submits encrypted material for translation." style="text;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;align=left;verticalAlign=top;whiteSpace=wrap;" parent="6" vertex="1">
                    <mxGeometry x="18" y="122" width="266" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="&lt;b&gt;3. AWS Private Certificate Authority (AWS Private CA)&lt;/b&gt;&#xa;Issues a short-lived certificate binding the application&#39;s ephemeral public key." style="text;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;align=left;verticalAlign=top;whiteSpace=wrap;" parent="6" vertex="1">
                    <mxGeometry x="18" y="212" width="266" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="&lt;b&gt;4. AWS Payment Cryptography&lt;/b&gt;&#xa;Validates the client certificate, derives the key, and translates the PIN block into the outgoing PEK domain inside its HSM boundary." style="text;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;align=left;verticalAlign=top;whiteSpace=wrap;" parent="6" vertex="1">
                    <mxGeometry x="18" y="302" width="266" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="s5" value="&lt;b&gt;5. Banking system or card processor&lt;/b&gt;&#xa;Completes PIN enrollment and owns PIN policy, verification, retry counting, and lockout." style="text;html=1;fontFamily=Arial;fontSize=10;fontColor=#000000;align=left;verticalAlign=top;whiteSpace=wrap;" parent="6" vertex="1">
                    <mxGeometry x="18" y="398" width="266" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
